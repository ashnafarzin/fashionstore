@{
    ViewData["Title"] = "Fashion Store";
}

<!-- Banner Section -->
<div class="hero-section text-center">
    <h1>Welcome to Fashion Store</h1>
    <p>Discover Your Perfect Style</p>
    <a href="#products" class="btn btn-dark">
        Shop Now
    </a>
</div>

<!-- Products Section -->
<div class="container mt-5" id="products">

    <h2 class="text-center mb-4">
        Our Latest Collection
    </h2>

    <div class="row">

        <!-- Product 1 -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="/images/floral.jpg"
                     class="card-img-top"
                     alt="Party Wear">

                <div class="card-body text-center">
                    <h5>Party Wear Dress</h5>
                    <p>₹1,799</p>
                    <a href="#" class="btn btn-primary">
                        View Details
                    </a>
                </div>
            </div>
        </div>

        <!-- Product 2 -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="/images/floral.jpg"
                     class="card-img-top"
                     alt="Party Wear">

                <div class="card-body text-center">
                    <h5>Party Wear Dress</h5>
                    <p>₹1,799</p>
                    <a href="#" class="btn btn-primary">
                        View Details
                    </a>
                </div>
            </div>
        </div>

        <!-- Product 3 -->
        <div class="col-md-4 mb-4">
            <div class="card">
                <img src="/images/blue.jpg"
                     class="card-img-top"
                     alt="Casual Dress">

                <div class="card-body text-center">
                    <h5>Casual Dress</h5>
                    <p>₹999</p>
                    <a href="#" class="btn btn-primary">
                        View Details
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>
